# Cada unidade tem seu próprio backend/banco ClinVida, sem nenhum dado
# compartilhado entre elas. O site funciona normalmente com só uma unidade
# configurada — a outra "liga" automaticamente quando a URL for preenchida.
API_BASE_URL_MATRIZ=http://clinvida.ddnsfree.com:9000
API_BASE_URL_FILIAL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Blog: um post por dia é gerado automaticamente (ver app/api/cron/blog e o
# cron em vercel.json) com base nas datas do Calendário de Saúde
# (lib/calendarioSaude.js). Precisa do Upstash Redis abaixo para persistir os
# posts entre deploys/instâncias — sem ele, cai num Map em memória (só para dev).
# CRON_SECRET protege a rota para que só o Vercel Cron consiga chamá-la.
CRON_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Geração de imagem do Instagram (sob demanda, botão em /admin/instagram).
# Pelo menos uma das duas precisa estar configurada; o seletor no admin deixa
# escolher qual usar por rascunho.
GEMINI_API_KEY=

# WhatsApp via UAZAPI (não-oficial) — uma instância já criada por unidade,
# token copiado do dashboard da conta UAZAPI. Gerenciadas em /admin/whatsapp
# (status, QR code, conectar, desconectar). Uma unidade sem
# UAZAPI_BASE_URL_<ID>/UAZAPI_TOKEN_<ID> simplesmente fica desligada, mesmo
# padrão de API_BASE_URL_<ID> acima.
UAZAPI_BASE_URL_MATRIZ=
UAZAPI_TOKEN_MATRIZ=
UAZAPI_BASE_URL_FILIAL=
UAZAPI_TOKEN_FILIAL=

# Segredo compartilhado para validar que o POST em
# /api/whatsapp/<unidade>/webhook vem mesmo da UAZAPI — usar a mesma string
# na URL do webhook cadastrada no dashboard de cada instância (ex.:
# .../api/whatsapp/matriz/webhook?secret=SEU_SEGREDO).
UAZAPI_WEBHOOK_SECRET=

# Para o WhatsApp, UPSTASH_REDIS_REST_URL/TOKEN (acima) passam a ser
# obrigatórios em produção: a pausa de 60min por atendimento humano e a
# dedupe de mensagens do webhook dependem de estado compartilhado entre
# invocações serverless. Sem Redis configurado, funciona só em memória (dev).

# Feature flags: ligam/desligam funcionalidades inteiras (página pública,
# seção do admin, link de navegação e cron/rota correspondentes). Por padrão
# tudo fica ativado — só desative escrevendo "false" (deixar em branco não
# desativa). Precisam do prefixo NEXT_PUBLIC_ porque também são lidas nos
# componentes de navegação (Header, Footer, AdminNav) no navegador.
NEXT_PUBLIC_FEATURE_BLOG=true
NEXT_PUBLIC_FEATURE_INSTAGRAM=true
NEXT_PUBLIC_FEATURE_CALENDARIO=true
NEXT_PUBLIC_FEATURE_WHATSAPP=true
NEXT_PUBLIC_FEATURE_CHAT=true
NEXT_PUBLIC_FEATURE_PROFISSIONAIS=true
# Só desliga o wizard de marcar consulta NOVA pelo site (/agendamento e o
# perfil do profissional) — não afeta cancelar/reagendar na Área do Cliente.
NEXT_PUBLIC_FEATURE_AGENDAMENTO=true
